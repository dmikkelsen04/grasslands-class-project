{
  "name": "GrasslandsClassProject",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "CreatureAssets": {
        "$path": "assets/creatures"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "StarterGui": {
      "GameUI": {
        "$path": "src/ui"
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      },
      "Grasslands": {
        "$path": "world/grasslands"
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 2,
        "Ambient": [
          0.490196,
          0.521569,
          0.458824
        ],
        "OutdoorAmbient": [
          0.568627,
          0.592157,
          0.529412
        ],
        "GlobalShadows": true
      }
    }
  }
}

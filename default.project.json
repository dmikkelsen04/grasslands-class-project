{
  "name": "GrasslandsClassProject",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "Server": { "$path": "src/server" }
    },
    "ServerStorage": {
      "CreatureAssets": { "$path": "assets/creatures" }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": { "$path": "src/client" }
      }
    },
    "StarterGui": {
      "GameUI": { "$path": "src/ui" }
    },
    "Workspace": {
      "$properties": { "FilteringEnabled": true },
      "Grasslands": { "$path": "world/grasslands" }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14,
        "Brightness": 2,
        "Ambient": [0.5, 0.5, 0.5],
        "OutdoorAmbient": [0.65, 0.65, 0.65],
        "GlobalShadows": true
      }
    }
  }
}
